# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
# APP_URL must match the site's real, canonical origin. It is used to
# generate canonical tags, sitemap URLs and feed links, so a wrong value
# here causes duplicate-content problems in search engines.
APP_NAME=PurrQuery
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Content is stored in UTC and converted for display. Keep this as UTC.
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# ------------------------------------------------------------------
# Security
# ------------------------------------------------------------------
BCRYPT_ROUNDS=12

# Set to true in production so session cookies are only sent over HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

# ------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=puurquery
DB_USERNAME=root
DB_PASSWORD=

# ------------------------------------------------------------------
# Cache, queue and storage
# ------------------------------------------------------------------
# Redis is not installed on the dev machine, so these use the database.
# Switch CACHE_STORE/QUEUE_CONNECTION/SESSION_DRIVER to "redis" in
# production if a Redis server is available.
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ------------------------------------------------------------------
# Mail
# ------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="noreply@purrquery.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------
# Frontend
# ------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# ------------------------------------------------------------------
# Brand
# ------------------------------------------------------------------
# Copy that appears in titles, meta descriptions and structured data.
# Leave unset to use the defaults in config/brand.php.
BRAND_EMAIL="hello@purrquery.com"
